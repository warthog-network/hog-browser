#!/bin/sh
# Install Docker Engine (docker-ce) beside Docker Desktop.
# Invoked only as: pkexec /usr/libexec/hog-docker-engine-install
# or pkexec /opt/hog-browser/libexec/hog-docker-engine-install
# Takes no arguments. Idempotent. Does not install Docker Desktop or the NVIDIA toolkit.
set -eu

if [ "$#" -ne 0 ]; then
  echo "This helper takes no arguments." >&2
  exit 2
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "This helper must run as root via pkexec." >&2
  exit 1
fi

export DEBIAN_FRONTEND=noninteractive
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

if [ ! -r /etc/os-release ]; then
  echo "Could not read /etc/os-release." >&2
  exit 1
fi

# shellcheck disable=SC1091
. /etc/os-release
ident="$(printf '%s' "${ID:-ubuntu}" | tr '[:upper:]' '[:lower:]')"
if [ "$ident" = "debian" ]; then
  distro="debian"
  codename="${VERSION_CODENAME:-}"
else
  distro="ubuntu"
  codename="${UBUNTU_CODENAME:-${VERSION_CODENAME:-}}"
fi
if [ -z "$codename" ]; then
  echo "Could not read this distribution's version codename from /etc/os-release." >&2
  exit 1
fi

arch="$(dpkg --print-architecture)"
case "$arch" in
  amd64|arm64|armhf|s390x|ppc64le) ;;
  *)
    echo "Docker Engine packages are not published for ${arch}." >&2
    exit 1
    ;;
esac

echo "Installing prerequisites…"
apt-get update
apt-get install -y ca-certificates curl

echo "Adding Docker's apt repository…"
install -m 0755 -d /etc/apt/keyrings
curl -fsSL --proto '=https' --tlsv1.2 -o /etc/apt/keyrings/docker.asc \
  "https://download.docker.com/linux/${distro}/gpg"
chmod a+r /etc/apt/keyrings/docker.asc
printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/%s %s stable\n' \
  "$arch" "$distro" "$codename" > /etc/apt/sources.list.d/docker.list
chmod a+r /etc/apt/sources.list.d/docker.list

echo "Installing Docker Engine…"
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

echo "Starting docker.service. Docker Desktop is not changed."
systemctl enable --now docker

uid="${PKEXEC_UID:-}"
if [ -n "$uid" ]; then
  user="$(id -nu "$uid" 2>/dev/null || true)"
  if [ -n "$user" ] && [ "$user" != "root" ]; then
    echo "Adding ${user} to the docker group…"
    usermod -aG docker "$user"
    echo "Docker Engine is installed. Log out and back in so ${user} can use it."
    exit 0
  fi
fi

echo "Docker Engine is installed. Add your user to the docker group, then log out and back in."
