#!/bin/sh
# Install and configure the NVIDIA Container Toolkit for Docker Engine.
# Invoked only as: pkexec /opt/hog-browser/libexec/hog-nvidia-toolkit-install
# Takes no arguments. Idempotent. Never touches Docker Desktop.
set -eu

if [ "$#" -ne 0 ]; then
  echo "This helper takes no arguments." >&2
  exit 2
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "This helper must run as root via pkexec." >&2
  exit 1
fi

export DEBIAN_FRONTEND=noninteractive
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

echo "Installing prerequisites…"
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl gnupg2

echo "Adding the NVIDIA Container Toolkit apt repository…"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor -o "$tmp"
install -m 644 "$tmp" /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | \
  sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
  tee /etc/apt/sources.list.d/nvidia-container-toolkit.list >/dev/null
chmod 644 /etc/apt/sources.list.d/nvidia-container-toolkit.list

echo "Installing nvidia-container-toolkit…"
apt-get update
apt-get install -y nvidia-container-toolkit

echo "Configuring the NVIDIA runtime for Docker Engine…"
nvidia-ctk runtime configure --runtime=docker

if systemctl cat docker.service >/dev/null 2>&1; then
  echo "Restarting docker.service (Docker Engine). Docker Desktop is not changed."
  systemctl restart docker.service
else
  echo "docker.service was not found; the toolkit is installed but Docker Engine was not restarted. Docker Desktop was not changed."
fi

echo "NVIDIA Container Toolkit is installed and configured."
