        self.area.connect("leave-notify-event", self.on_leave)
        self.area.connect("realize", self.on_realize)
        self.area.connect("size-allocate", self.on_size)

    def widget(self):
        return self.area

    def prepare(self):
        screen = self.area.get_screen() or Gdk.Screen.get_default()
        if screen is None:
            return
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.area.set_visual(visual)

    def on_realize(self, widget):
        display = widget.get_display()
        cursor = Gdk.Cursor.new_from_name(display, "grab")
        window = widget.get_window()
        if window is None:
            return
        if cursor is not None:
            window.set_cursor(cursor)
        alloc = widget.get_allocation()
        self.apply_shape(alloc.width, alloc.height)

    def on_size(self, _widget, allocation):
        self.apply_shape(allocation.width, allocation.height)

    def add_path(self, cr, width, height):
        radius = min(8, height / 2.0, width)
        cr.new_path()
        if self.side == "tabs":
            cr.move_to(0, 0)
            cr.line_to(max(0, width - radius), 0)
            cr.arc(width - radius, radius, radius, -math.pi / 2, 0)
            cr.line_to(width, height - radius)
            cr.arc(width - radius, height - radius, radius, 0, math.pi / 2)
            cr.line_to(0, height)
        else:
            cr.move_to(width, 0)
            cr.line_to(radius, 0)
            cr.arc_negative(radius, radius, radius, -math.pi / 2, math.pi)
            cr.line_to(0, height - radius)
            cr.arc_negative(radius, height - radius, radius, math.pi, math.pi / 2)
            cr.line_to(width, height)
        cr.close_path()

    def apply_shape(self, width, height):
        window = self.area.get_window()
        if window is None or width < 2 or height < 2:
            return
        surface = pycairo.ImageSurface(pycairo.FORMAT_A8, int(width), int(height))
        ctx = pycairo.Context(surface)
        ctx.set_antialias(pycairo.ANTIALIAS_NONE)
        self.add_path(ctx, width, height)
        ctx.set_source_rgba(0, 0, 0, 1)
        ctx.fill()
        region = Gdk.cairo_region_create_from_surface(surface)
        self.area.shape_combine_region(region)
        self.area.input_shape_combine_region(region)
        try:
            window.set_opaque_region(region)
        except Exception:
            pass

    def _js(self, script):
        try:
            self.chrome.run_javascript(script, None, None, None)
        except Exception:
            pass

    def show_box(self, x, y, w, h, track):
        if self.dragging:
            return
        if w < 8 or w > 40 or h < 20 or h > 80:
            self.area.hide()
            return
        self.track_y = int(track[1]) if track else 0
        self.track_h = int(track[3]) if track else 0
        place_overlay(self.area, x, y, w, h)

    def hide(self):
        self.area.hide()

    def clamp_y(self, y):
        height = self.area.get_allocated_height() or 36
        if self.track_h <= height + 16:
            return max(0, int(y))
        low = self.track_y + 8
        high = self.track_y + self.track_h - height - 8
        return min(high, max(low, int(y)))

    def on_press(self, widget, event):
        if getattr(event, "button", 1) != 1 or event.type != Gdk.EventType.BUTTON_PRESS:
            return False
        self.dragging = True
        self.moved = False
        self.down_root = event.y_root
        self.origin_y = widget.get_margin_top()
        window = widget.get_window()
        try:
            seat = widget.get_display().get_default_seat()
            if seat is not None and window is not None:
                seat.grab(window, Gdk.SeatCapabilities.ALL_POINTING, False, None, event, None)
        except Exception:
            pass
        cursor = Gdk.Cursor.new_from_name(widget.get_display(), "grabbing")
        if window is not None and cursor is not None:
            window.set_cursor(cursor)
        self._js(f"window.__hogSpotDown && window.__hogSpotDown('{self.side}')")
        return True

    def on_motion(self, widget, event):
        if not self.dragging:
            return False
        dy = event.y_root - self.down_root
        if abs(dy) < 4:
            return True
        self.moved = True
        y = self.clamp_y(self.origin_y + dy)
        place_overlay(widget, widget.get_margin_start(), y, widget.get_allocated_width(), widget.get_allocated_height())
        self._js(f"window.__hogSpotSlide && window.__hogSpotSlide('{self.side}', {y})")
        return True

    def on_release(self, widget, event):
        if not self.dragging:
            return False
        self.dragging = False
        try:
            seat = widget.get_display().get_default_seat()
            if seat is not None:
                seat.ungrab()
        except Exception:
            pass
        window = widget.get_window()
        cursor = Gdk.Cursor.new_from_name(widget.get_display(), "grab")
        if window is not None and cursor is not None:
            window.set_cursor(cursor)
        moved = "1" if self.moved else "0"
        self._js(f"window.__hogSpotUp && window.__hogSpotUp('{self.side}', {moved})")
        return True

    def on_enter(self, _widget, _event):
        if self.dragging:
            return False
        self._js(f"window.__hogSpotIn && window.__hogSpotIn('{self.side}')")
        return False

    def on_leave(self, _widget, _event):
        if self.dragging:
            return False
        self._js(f"window.__hogSpotOut && window.__hogSpotOut('{self.side}')")
        return False

    def on_draw(self, widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        if width < 2 or height < 2:
            return False
        cr.save()
        cr.set_operator(pycairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.restore()
        cr.set_antialias(pycairo.ANTIALIAS_NONE)
        self.add_path(cr, width, height)
        cr.set_source_rgb(*GOLD)
        cr.fill()
        cr.set_antialias(pycairo.ANTIALIAS_DEFAULT)
        size = 3
        gap = 3
        grid = size * 2 + gap
        x0 = (width - grid) / 2
        y0 = (height - grid) / 2
        cr.set_source_rgb(*DOT)
        for row in range(2):
            for col in range(2):
                cx = x0 + col * (size + gap) + size / 2
                cy = y0 + row * (size + gap) + size / 2
                cr.new_path()
                cr.arc(cx, cy, size / 2, 0, math.tau)
                cr.fill()
        return False


def drop_copy_note(lines):
    names = []
    for line in lines:
        path = urllib.parse.unquote(urllib.parse.urlparse(line).path).rstrip("/")
        name = path.split("/")[-1] if path else ""
        if name and name not in {".", ".."}:
            names.append(name)
    if len(names) == 1:
        return f"Adding {names[0]}…"
    if len(names) > 1:
        return f"Adding {len(names)} files…"
    return "Adding…"


class Hog(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.HANDLES_OPEN,
        )
        self.server = None
        self.grip = None
        self.using_edge_cursor = False
        self.pages = None
        self.chrome = None
        self.pill = None
        self.window = None
        self.tabs_line = None
        self.wallet_line = None
        self.tabs_spot = None
        self.wallet_spot = None
        self.grip_boxes = [None, None]
        self.pending_urls = []
        self.chrome_ready = False

    def on_window_message(self, _manager, result, window):
        try:
            value = result.get_js_value()
            if value is None or not value.is_string():
                return
            command = value.to_string()
        except Exception:
            return
        if self.pages is not None and self.pages.command(command):
            return
        if command == "pill:hide":
            if self.pill is not None:
                self.pill.hide()
            return
        if command.startswith("pill:"):
            parts = command.split(":")
            if self.pill is None or len(parts) < 7:
                return
            try:
                x, y, w, h = (int(parts[1]), int(parts[2]), int(parts[3]), int(parts[4]))
            except ValueError:
                return
            self.pill.show_at(x, y, w, h, parts[5], ":".join(parts[6:]))
            return
        if command.startswith("edges:"):
            self.place_edges(command)
            return
        if command.startswith("open:"):
            self.open_tailscale_login(command[5:])
            return
        if command.startswith("drop-box:"):
            self.place_share_drop(command[len("drop-box:"):])
            return
        if command.startswith("containers:"):
            self.on_containers(command)
            return
        if command.startswith("dapp-reply:"):
            if self.pages is not None:
                self.pages.deliver_dapp_reply(command[len("dapp-reply:"):])
            return
        if command.startswith("dapp-emit:"):
            if self.pages is not None:
                self.pages.deliver_dapp_emit(command[len("dapp-emit:"):])
            return
        if command == "menu:hide":
            if self.pages is not None:
                self.pages.paint_menu(None)
            return
        if command.startswith("menu:"):
            if self.pages is not None:
                self.pages.paint_menu(command[5:])
            return
        if command == "close":
            window.close()
        elif command == "min":
            window.iconify()
        elif command == "max":
            if window.is_maximized():
                window.unmaximize()
            else:
                window.maximize()
        elif command.startswith("grip:"):
            parts = command.split(":")
            if len(parts) != 5:
                return
            try:
                self.grip = tuple(int(part) for part in parts[1:])
            except ValueError:
                self.grip = None

    def open_tailscale_login(self, url):
        text = allowed_tailscale_open_url(url)
        if not text:
            return
        # Prefer a Hog tab so login stays in-app. Fall back only when pages are gone.
        if self.pages is not None:
            self.pages.tell({
                "event": "popup",
                "url": text,
                "isolated": False,
            })
            return
        if self.window is None:
            return
        try:
            Gtk.show_uri_on_window(self.window, text, Gdk.CURRENT_TIME)
        except Exception:
            pass

    def open_external_url(self, url):
        text = allowed_browser_open_url(url)
        if not text:
            return
        if self.pages is not None and self.chrome_ready:
            self.pages.tell({
                "event": "popup",
                "url": text,
                "isolated": False,
            })
            return
        if text not in self.pending_urls and len(self.pending_urls) < 20:
            self.pending_urls.append(text)

    def flush_pending_urls(self):
        if self.pages is None:
            return
        pending = list(self.pending_urls)
        self.pending_urls.clear()
        for url in pending:
            self.pages.tell({
                "event": "popup",
                "url": url,
                "isolated": False,
            })

    def place_share_drop(self, text):
        target = getattr(self, "share_drop", None)
        if target is None:
            return
        parts = str(text or "").split(",")
        if len(parts) != 4:
            target.hide()
            return
        try:
            x, y, w, h = (int(part) for part in parts)
        except ValueError:
            target.hide()
            return
        target.show_box(x, y, w, h)

    def receive_share_drop(self, uris):
        lines = []
        for uri in uris:
            text = str(uri or "").strip()
            if text.startswith("file://") and len(text) < 500 and "\n" not in text and "\r" not in text:
                lines.append(text)
            if len(lines) >= 200:
                break
        if not lines:
            self.note_library("Nothing was added. Choose files on this computer.")
            return
        self.note_library(drop_copy_note(lines))
        self.on_containers("containers:share-drop:" + "\n".join(lines))

    def note_library(self, text):
        if self.chrome is None:
            return
        raw = json.dumps(str(text or "")[:240])

        def deliver():
            try:
                self.chrome.run_javascript(
                    f"window.__hogMediaNote && window.__hogMediaNote({raw})",
                    None, None, None,
                )
            except Exception:
                pass
            return False

        GLib.idle_add(deliver)

    def pick_share_folder(self):
        if self.window is None or getattr(self, "_share_dialog", None) is not None:
            return
        dialog = Gtk.FileChooserDialog(
            title="Choose a folder to share with the phone",
            parent=self.window,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Share", Gtk.ResponseType.OK)
        dialog.set_local_only(True)
        try:
            dialog.set_current_folder(str(Path.home()))
        except Exception:
            pass
        self._share_dialog = dialog

        def on_response(_dialog, response):
            path = dialog.get_filename() if response == Gtk.ResponseType.OK else ""
            dialog.destroy()
            self._share_dialog = None
            if not path or any(ch in path for ch in ("\n", "\r", "\x00")):
                return
            self.on_containers(f"containers:share-network:{path}")

        dialog.connect("response", on_response)
        dialog.show()

    def pick_library(self, kind):
        if self.window is None or getattr(self, "_share_dialog", None) is not None:
            return
        folders = kind == "folder"
        dialog = Gtk.FileChooserDialog(
            title="Add a folder to the library" if folders else "Add files to the library",
            parent=self.window,
            action=Gtk.FileChooserAction.SELECT_FOLDER if folders else Gtk.FileChooserAction.OPEN,
        )
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Add", Gtk.ResponseType.OK)
        dialog.set_local_only(True)
        if not folders:
            dialog.set_select_multiple(True)
        try:
            dialog.set_current_folder(str(Path.home()))
        except Exception:
            pass
        self._share_dialog = dialog

        def on_response(_dialog, response):
            uris = []
            if response == Gtk.ResponseType.OK:
                try:
                    uris = list(dialog.get_uris() or [])
                except Exception:
                    uris = []
            dialog.destroy()
            self._share_dialog = None
            if uris:
                self.receive_share_drop(uris)

        dialog.connect("response", on_response)
        dialog.show()

    def on_containers(self, command):
        parts = command.split(":", 2)
        action = parts[1] if len(parts) > 1 else ""
        rest = parts[2] if len(parts) > 2 else ""
        if action not in {"list", "add", "remove", "start", "stop", "logs", "launch", "create", "run", "recreate", "engine", "engine-start", "shell", "shell-close", "commit", "modprobe", "endpoint", "tailscale-up", "share-list", "share-status", "share-computer", "share-network", "share-remove", "share-publish", "share-pick", "share-drop", "media-open", "media-mkdir", "media-remove", "media-pick", "media-pick-folder", "browser-default", "browser-default-set", "browser-default-clear", "jellyfin-gpu", "jellyfin-gpu-set", "jellyfin-gpu-clear", "jellyfin-gpu-install"}:
            return
        if action == "share-pick":
            self.pick_share_folder()
            return
        if action == "media-pick":
            self.pick_library("files")
            return
        if action == "media-pick-folder":
            self.pick_library("folder")
            return
        guard = getattr(self, "guard", None)
        if guard is None:
            return
        if action == "media-open":
            guard.use_library(rest)
        if action == "create":
            name, _, image = rest.partition(":")
        elif action in {"run", "recreate"}:
            name, image = rest, ""
        else:
            name, image = rest, ""

        def work():
            try:
                payload = guard.handle(action, name, image)
            except RuntimeError as exc:
                payload = {"ok": False, "error": str(exc), "items": []}
            raw = json.dumps(payload)

            def deliver():
                try:
                    self.chrome.run_javascript(
                        f"window.__hogContainers && window.__hogContainers({raw})",
                        None, None, None,
                    )
                except Exception:
                    pass
                return False

            GLib.idle_add(deliver)

        threading.Thread(target=work, daemon=True).start()

    def edge_at(self, widget, x, y):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        edge = 6
        corner = 16
        left = x <= edge or (x <= corner and (y <= corner or y >= height - corner))
        right = x >= width - edge or (x >= width - corner and (y <= corner or y >= height - corner))
        top = y <= edge or (y <= corner and (x <= corner or x >= width - corner))
        bottom = y >= height - edge or (y >= height - corner and (x <= corner or x >= width - corner))
        if top and left:
            return Gdk.WindowEdge.NORTH_WEST
        if top and right:
            return Gdk.WindowEdge.NORTH_EAST
        if bottom and left:
            return Gdk.WindowEdge.SOUTH_WEST
        if bottom and right:
            return Gdk.WindowEdge.SOUTH_EAST
        if top:
            return Gdk.WindowEdge.NORTH
        if bottom:
            return Gdk.WindowEdge.SOUTH
        if left:
            return Gdk.WindowEdge.WEST
        if right:
            return Gdk.WindowEdge.EAST
        return None

    def edge_at_window(self, event):
        if self.window is None:
            return None
        gdk_win = self.window.get_window()
        if gdk_win is None:
            return None
        origin_x, origin_y = gdk_win.get_root_coords(0, 0)
        return self.edge_at_point(
            event.x_root - origin_x,
            event.y_root - origin_y,
            self.window.get_allocated_width(),
            self.window.get_allocated_height(),
        )

    def edge_at_point(self, x, y, width, height):
        edge = 6
        corner = 16
        left = x <= edge or (x <= corner and (y <= corner or y >= height - corner))
        right = x >= width - edge or (x >= width - corner and (y <= corner or y >= height - corner))
        top = y <= edge or (y <= corner and (x <= corner or x >= width - corner))
        bottom = y >= height - edge or (y >= height - corner and (x <= corner or x >= width - corner))
        if top and left:
            return Gdk.WindowEdge.NORTH_WEST
        if top and right:
            return Gdk.WindowEdge.NORTH_EAST
        if bottom and left:
            return Gdk.WindowEdge.SOUTH_WEST
        if bottom and right:
            return Gdk.WindowEdge.SOUTH_EAST
        if top:
            return Gdk.WindowEdge.NORTH
        if bottom:
            return Gdk.WindowEdge.SOUTH
        if left:
            return Gdk.WindowEdge.WEST
        if right:
            return Gdk.WindowEdge.EAST
        return None

    def place_edges(self, command):
        parts = command.split(":")
        if len(parts) != 17 or self.tabs_spot is None:
            return
        try:
            nums = [int(part) for part in parts[1:]]
        except ValueError:
            return
        lines = (self.tabs_line, self.wallet_line)
        spots = (self.tabs_spot, self.wallet_spot)
        for index, line in enumerate(lines):
            box = nums[index * 4:(index + 1) * 4]
            line.show_box(*box)
        # The square GTK grip paints black corners on Wayland (shapes are
        # unsupported). Remember where it sits so edge-resize yields to it,
        # and let the page draw the rounded grip.
        for index, spot in enumerate(spots):
            box = tuple(nums[(index + 2) * 4:(index + 3) * 4])
            spot.hide()
            self.grip_boxes[index] = box if box[2] > 0 and box[3] > 0 else None
        if self.pages is not None:
            page_top = self.pages.box.get_margin_top()
            self.pages.paint_grips(
                nums[10] > 0,
                nums[9] - page_top,
                nums[14] > 0,
                nums[13] - page_top,
            )

    def watch_page(self, view):
        view.add_events(
            Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
        )
        view.connect("motion-notify-event", self.on_page_motion)
        view.connect("leave-notify-event", self.on_page_leave)
        view.connect("button-press-event", self.on_page_button)

    def window_point(self, event):
        if self.window is None:
            return None
        gdk_win = self.window.get_window()
        if gdk_win is None:
            return None
        origin_x, origin_y = gdk_win.get_root_coords(0, 0)
        return event.x_root - origin_x, event.y_root - origin_y

    def over_grip(self, event):
        point = self.window_point(event)
        if point is None:
            return False
        x, y = point
        for box in self.grip_boxes:
            if not box or box[2] <= 0 or box[3] <= 0:
                continue
            if box[0] <= x <= box[0] + box[2] and box[1] <= y <= box[1] + box[3]:
                return True
        return False

    def shift_grip(self, side, css_top):
        index = 0 if side == "tabs" else 1
        box = self.grip_boxes[index]
        if not box or self.pages is None:
            return
        y = self.pages.box.get_margin_top() + int(css_top)
        self.grip_boxes[index] = (box[0], y, box[2], box[3])

    def on_page_motion(self, view, event):
        if self.over_grip(event):
            self.paint_cursor(view, None)
            return False
        edge = self.edge_at_window(event)
        self.paint_cursor(view, self.cursor_name(edge) if edge is not None else None)
        return False

    def on_page_leave(self, view, _event):
        self.paint_cursor(view, None)
        return False

    def on_page_button(self, view, event):
        if event.button != 1 or event.type != Gdk.EventType.BUTTON_PRESS:
            return False
        if self.over_grip(event):
            return False
        edge = self.edge_at_window(event)
        if edge is None or self.window is None:
            return False
        self.window.begin_resize_drag(edge, int(event.button), int(event.x_root), int(event.y_root), event.time)
        return True

    def cursor_name(self, edge):
        return {
            Gdk.WindowEdge.NORTH: "n-resize",
            Gdk.WindowEdge.SOUTH: "s-resize",
            Gdk.WindowEdge.WEST: "w-resize",
            Gdk.WindowEdge.EAST: "e-resize",
            Gdk.WindowEdge.NORTH_WEST: "nw-resize",
            Gdk.WindowEdge.NORTH_EAST: "ne-resize",
            Gdk.WindowEdge.SOUTH_WEST: "sw-resize",
            Gdk.WindowEdge.SOUTH_EAST: "se-resize",
        }[edge]

    def paint_cursor(self, widget, name):
        gdk_window = widget.get_window()
        if gdk_window is None:
            return
        if not name:
            gdk_window.set_cursor(None)
            self.using_edge_cursor = False
            return
        gdk_window.set_cursor(Gdk.Cursor.new_from_name(gdk_window.get_display(), name))
        self.using_edge_cursor = True

    def on_motion(self, view, event):
        edge = self.edge_at(view, event.x, event.y)
        self.paint_cursor(view, self.cursor_name(edge) if edge is not None else None)
        return False

    def on_leave(self, view, _event):
        self.paint_cursor(view, None)
        return False

    def on_button(self, view, event, window):
        if event.button != 1:
            return False
        if event.type not in (Gdk.EventType.BUTTON_PRESS, Gdk.EventType._2BUTTON_PRESS):
            return False
        edge = self.edge_at(view, event.x, event.y)
        if edge is not None and event.type == Gdk.EventType.BUTTON_PRESS:
            window.begin_resize_drag(edge, int(event.button), int(event.x_root), int(event.y_root), event.time)
            return True
        if not self.grip:
            return False
        x, y, width, height = self.grip
        if not (x <= event.x <= x + width and y <= event.y <= y + height):
            return False
        if event.type == Gdk.EventType._2BUTTON_PRESS:
            if window.is_maximized():
                window.unmaximize()
            else:
                window.maximize()
            return True
        window.begin_move_drag(int(event.button), int(event.x_root), int(event.y_root), event.time)
        return True

    def ensure_server(self):
        if port_open(PORT):
            return
        bundle = ROOT / "public" / "wallet-bundle.js"
        if not bundle.is_file():
            subprocess.run([node_binary(), "scripts/build.mjs"], cwd=ROOT, check=True)
        self.server = subprocess.Popen(
            [node_binary(), "server.mjs"],
            cwd=ROOT,
            env={**os.environ, "HOG_PORT": str(PORT)},
            start_new_session=True,
        )
        for _ in range(50):
            if port_open(PORT):
                return
            if self.server.poll() is not None:
                sys.exit("Hog's local server stopped before the window opened.")
            time.sleep(0.1)
        sys.exit("Hog's local server did not start.")

    def do_shutdown(self):
        if self.server and self.server.poll() is None:
            os.killpg(self.server.pid, signal.SIGTERM)
        Gtk.Application.do_shutdown(self)

    def ensure_window(self):
        if self.window is not None:
            return
        self.ensure_server()
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        window = Gtk.ApplicationWindow(application=self, title="Hog")
        screen = window.get_screen() or Gdk.Screen.get_default()
        if screen is not None:
            visual = screen.get_rgba_visual()
            if visual is not None:
                window.set_visual(visual)
        window.set_decorated(False)
        window.set_default_size(1180, 760)
        icon = None
        for candidate in (
            ROOT / "public" / "hog-icon.png",
            ROOT / "public" / "hog-icon.svg",
            ROOT / "public" / "favicon.svg",
        ):
            if candidate.is_file():
                icon = candidate
                break
        if icon is not None:
            try:
                Gtk.Window.set_default_icon_from_file(str(icon))
                window.set_icon_from_file(str(icon))
            except Exception:
                pass

        DATA.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(DATA, 0o700)
        except OSError:
            pass
        (DATA / "cache").mkdir(parents=True, exist_ok=True)
        self.guard = Guard(DATA, origin=f"http://127.0.0.1:{PORT}")
        page_sandbox = "true" if sandbox_available() else "false"
        manager = WebKit2.WebsiteDataManager(
            base_data_directory=str(DATA),
            base_cache_directory=str(DATA / "cache"),
        )
        context = WebKit2.WebContext.new_with_website_data_manager(manager)
        view = WebKit2.WebView.new_with_context(context)
        background = Gdk.RGBA()
        background.parse("#141416")
        view.set_background_color(background)
        settings = view.get_settings()
        settings.set_enable_javascript(True)
        settings.set_javascript_can_access_clipboard(True)
        settings.set_enable_media(True)
        settings.set_media_playback_requires_user_gesture(False)
        settings.set_media_playback_allows_inline(True)
        # The node page refuses to start until the file system API exists.
        # This GTK build still has no working sync file handle; the page stores
        # the chain through Hog's disk endpoint instead.
        node_features = {"FileSystem", "FileSystemWritableStream", "StorageAPI", "AccessHandle"}
        features = settings.get_all_features()
        for index in range(features.get_length()):
            feature = features.get(index)
            if feature.get_identifier() in node_features:
                settings.set_feature_enabled(feature, True)
        content = view.get_user_content_manager()
        content.register_script_message_handler("hogwin")
        content.connect("script-message-received::hogwin", self.on_window_message, window)
        content.add_script(WebKit2.UserScript(
            f"window.__hogDesktop=true;window.__hogPageSandbox={page_sandbox};",
            WebKit2.UserContentInjectedFrames.TOP_FRAME,
            WebKit2.UserScriptInjectionTime.START,
            None,
            None,
        ))
        view.add_events(
            Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
        )
        view.connect("motion-notify-event", self.on_motion)
        view.connect("leave-notify-event", self.on_leave)
        view.connect("button-press-event", self.on_button, window)
        window.set_resizable(True)
        self.chrome = view
        self.window = window
        self.pages = PageHost(view)
        self.pages.on_view = self.watch_page
        self.pages.on_grip_move = self.shift_grip
        self.pill = EdgePill(view)
        self.share_drop = ShareDrop(self.receive_share_drop)
        self.tabs_line = EdgeLine()
        self.wallet_line = EdgeLine()
        self.tabs_spot = EdgeSpot(view, "tabs")
        self.wallet_spot = EdgeSpot(view, "wallet")
        overlay = Gtk.Overlay()
        overlay.add(view)
        overlay.add_overlay(self.pages.widget())
        overlay.add_overlay(self.tabs_line.widget())
        overlay.add_overlay(self.wallet_line.widget())
        overlay.add_overlay(self.tabs_spot.widget())
        overlay.add_overlay(self.wallet_spot.widget())
        overlay.add_overlay(self.pill.widget())
        overlay.add_overlay(self.share_drop.widget())
        view.load_uri(URL)

        def on_load(web_view, event):
            if event == WebKit2.LoadEvent.FINISHED:
                print(f"Hog is open at {URL}", flush=True)
                self.chrome_ready = True
                self.flush_pending_urls()

        view.connect("load-changed", on_load)
        window.add(overlay)
        self.tabs_spot.prepare()
        self.wallet_spot.prepare()
        window.show_all()
        self.pages.widget().hide()
        self.pill.hide()
        self.share_drop.hide()
        self.tabs_line.hide()
        self.wallet_line.hide()
        self.tabs_spot.hide()
        self.wallet_spot.hide()
        window.present()


    def do_activate(self):
        self.ensure_window()
        if self.window is not None:
            self.window.present()

    def do_open(self, files, hint):
        self.ensure_window()
        for item in files or []:
            try:
                uri = item.get_uri()
            except Exception:
                continue
            self.open_external_url(uri)
        if self.window is not None:
            self.window.present()


def main():
    GLib.set_prgname("hog")
    app = Hog()
    raise SystemExit(app.run(sys.argv))


if __name__ == "__main__":
    main()
