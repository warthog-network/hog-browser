def sandbox_available():
    context = WebKit2.WebContext()
    try:
        context.set_sandbox_enabled(True)
        return bool(context.get_sandbox_enabled())
    except Exception:
        return False


def harden_page_context(context, manager=None):
    """Page processes only. The wallet UI stays in the Hog shell."""
    try:
        context.set_sandbox_enabled(True)
    except Exception:
        pass
    try:
        context.set_process_model(WebKit2.ProcessModel.MULTIPLE_SECONDARY_PROCESSES)
    except Exception:
        pass
    if manager is None:
        return
    try:
        manager.set_itp_enabled(True)
    except Exception:
        pass


def port_open(port):
    with socket.socket() as sock:
        sock.settimeout(0.2)
        return sock.connect_ex(("127.0.0.1", port)) == 0


def node_binary():
    found = shutil.which("node")
    if found:
        return found
    for candidate in ("/usr/local/bin/node", "/usr/bin/node"):
        if Path(candidate).is_file():
            return candidate
    sys.exit("Hog needs Node.js. Install it, then run this again.")


def page_origin(uri):
    """http(s) origin of a page view. Hog's own ports are not a site."""
    parts = split_uri(uri)
    if parts is None:
        return ""
    scheme = parts.scheme.lower()
    if scheme not in ("http", "https"):
        return ""
    host = (parts.hostname or "").strip("[]").lower()
    if not host:
        return ""
    port = parts.port
    if host in ("127.0.0.1", "localhost") and port in (PORT, NODE_PORT):
        return ""
    default = 443 if scheme == "https" else 80
    if port and port != default:
        return f"{scheme}://{host}:{port}"
    return f"{scheme}://{host}"


def split_uri(uri):
    try:
        return urllib.parse.urlsplit(uri or "")
    except Exception:
        return None


def in_page_navigation(uri):
    """Schemes a page uses for its own frames and scripts, not a new site."""
    parts = split_uri(uri)
    if parts is None:
        return False
    scheme = parts.scheme.lower()
    if scheme in ("blob", "data", "javascript"):
        return True
    if scheme != "about":
        return False
    return parts.path.lower() in ("blank", "srcdoc")


def quiet_load_error(view, uri, error):
    """True when a failure should leave the page on screen."""
    try:
        if error.matches(WebKit2.NetworkError.quark(), WebKit2.NetworkError.CANCELLED):
            return True
        if error.matches(WebKit2.NetworkError.quark(), WebKit2.NetworkError.UNKNOWN_PROTOCOL):
            return True
        policy = WebKit2.PolicyError.quark()
        for code in (
            WebKit2.PolicyError.FRAME_LOAD_INTERRUPTED_BY_POLICY_CHANGE,
            WebKit2.PolicyError.CANNOT_SHOW_URI,
            WebKit2.PolicyError.CANNOT_USE_RESTRICTED_PORT,
        ):
            if error.matches(policy, code):
                return True
    except Exception:
        pass
    parts = split_uri(uri)
    scheme = parts.scheme.lower() if parts is not None else ""
    if scheme in ("http", "https"):
        return False
    try:
        current = view.get_uri() or ""
    except Exception:
        current = ""
    return current.startswith("http://") or current.startswith("https://")


