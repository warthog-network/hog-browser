class PageHost:
    """Real WebKit pages over the content area. The wallet stays on the chrome view."""

    def __init__(self, chrome):
        self.chrome = chrome
        self.box = Gtk.Stack()
        self.box.set_transition_type(Gtk.StackTransitionType.NONE)
        self.box.set_no_show_all(True)
        self.box.set_halign(Gtk.Align.FILL)
        self.box.set_valign(Gtk.Align.FILL)
        self.views = {}
        self.isolated = {}
        self.shared_context = None
        self.shown = None
        self.on_view = None
        self.grip_paint = None
        self.menu_paint = None
        self.on_grip_move = None

    def widget(self):
        return self.box

    def tell(self, payload):
        raw = json.dumps(payload)
        self.chrome.run_javascript(f"window.__hogPage && window.__hogPage({raw});", None, None, None)

    def tell_chrome(self, script):
        try:
            self.chrome.run_javascript(script, None, None, None)
        except Exception:
            pass

    def paint_grips(self, tabs_on, tabs_top, wallet_on, wallet_top):
        self.grip_paint = (
            bool(tabs_on),
            int(tabs_top),
            bool(wallet_on),
            int(wallet_top),
        )
        self.repaint_grips()

    def repaint_grips(self):
        if self.grip_paint is None or not self.shown:
            return
        view = self.views.get(self.shown)
        if view is None:
            return
        tabs_on, tabs_top, wallet_on, wallet_top = self.grip_paint
        payload = json.dumps({
            "tabs": tabs_on,
            "tabsTop": tabs_top,
            "wallet": wallet_on,
            "walletTop": wallet_top,
        })
        try:
            view.run_javascript(
                f"window.__hogEdgeGrips && window.__hogEdgeGrips({payload})",
                None,
                None,
                None,
            )
        except Exception:
            pass

    def paint_menu(self, raw):
        if raw is None:
            self.menu_paint = None
        else:
            try:
                data = json.loads(raw)
            except json.JSONDecodeError:
                return
            if not isinstance(data, dict):
                return
            self.menu_paint = data
        self.repaint_menu()

    def repaint_menu(self):
        if not self.shown:
            return
        view = self.views.get(self.shown)
        if view is None:
            return
        arg = "null" if self.menu_paint is None else json.dumps(self.menu_paint)
        try:
            view.run_javascript(f"window.__hogMenu && window.__hogMenu({arg})", None, None, None)
        except Exception:
            pass

    def on_grip_message(self, manager, result):
        try:
            value = result.get_js_value()
            if value is None or not value.is_string():
                return
            command = value.to_string()
        except Exception:
            return
        shown = self.views.get(self.shown) if self.shown else None
        if shown is None or shown.get_user_content_manager() != manager:
            return
        if command.startswith("dapp:"):
            self.on_dapp_request(shown, command[5:])
            return
        parts = command.split(":")
        if len(parts) >= 2 and parts[0] == "menu":
            self.on_menu_message(parts)
            return
        if len(parts) < 2 or parts[1] not in ("tabs", "wallet"):
            return
        kind, side = parts[0], parts[1]
        if kind == "click" and len(parts) == 2:
            self.tell_chrome(f"window.__hogEdgeClick && window.__hogEdgeClick('{side}')")
            return
        if kind == "end" and len(parts) == 2:
            self.tell_chrome(f"window.__hogEdgeEnd && window.__hogEdgeEnd('{side}')")
            return
        if kind != "move" or len(parts) != 3:
            return
        try:
            top = int(parts[2])
        except ValueError:
            return
        if top < -200 or top > 10000:
            return
        self.tell_chrome(f"window.__hogEdgeMove && window.__hogEdgeMove('{side}', {top})")
        if self.on_grip_move is not None:
            self.on_grip_move(side, top)

    def on_menu_message(self, parts):
        kind = parts[1]
        if kind == "dismiss" and len(parts) == 2:
            self.tell_chrome("window.__hogMenuDismiss && window.__hogMenuDismiss()")
            return
        if kind == "clear" and len(parts) == 2:
            self.tell_chrome("window.__hogMenuClear && window.__hogMenuClear()")
            return
        if kind not in ("suggestions", "history", "settings") or len(parts) != 3:
            return
        try:
            index = int(parts[2])
        except ValueError:
            return
        if index < 0 or index > 40:
            return
        self.tell_chrome(
            f"window.__hogMenuActivate && window.__hogMenuActivate('{kind}', {index})"
        )

    def on_dapp_request(self, view, raw):
        if len(raw) > 200_000:
            return
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            return
        if not isinstance(data, dict):
            return
        req_id = data.get("id")
        method = data.get("method")
        params = data.get("params", [])
        if isinstance(req_id, bool) or not isinstance(req_id, int) or req_id < 1 or req_id > 10**15:
            return
        if not isinstance(method, str) or not method or len(method) > 80:
            return
        if not isinstance(params, list):
            return
        origin = page_origin(view.get_uri() or "")
        tab = self.shown or ""
        if not origin:
            self.run_on_view(view, self.dapp_resolve_script(req_id, False, {
                "code": 4001,
                "message": "This page cannot connect.",
            }))
            return
        payload = {"id": req_id, "tab": tab, "origin": origin, "method": method, "params": params}
        self.tell_chrome(f"window.__hogDappAsk && window.__hogDappAsk({json.dumps(payload)})")

    def deliver_dapp_reply(self, raw):
        data = self.dapp_object(raw)
        if data is None:
            return
        req_id = data.get("id")
        tab = data.get("tab")
        if isinstance(req_id, bool) or not isinstance(req_id, int):
            return
        if not isinstance(tab, str) or not tab:
            return
        view = self.views.get(tab)
        if view is None:
            return
        ok = bool(data.get("ok"))
        payload = data.get("payload")
        self.run_on_view(view, self.dapp_resolve_script(req_id, ok, payload))

    def deliver_dapp_emit(self, raw):
        data = self.dapp_object(raw)
        if data is None:
            return
        origin = data.get("origin")
        event = data.get("event")
        if not isinstance(origin, str) or not origin.startswith(("https://", "http://")):
            return
        if event not in ("accountsChanged", "chainChanged"):
            return
        payload = data.get("payload")
        if event == "accountsChanged":
            if not isinstance(payload, list) or len(payload) > 4:
                return
            if any(not isinstance(item, str) or not item.startswith("0x") or len(item) != 42 for item in payload):
                return
        elif not isinstance(payload, str) or not payload.startswith("0x") or len(payload) > 12:
            return
        script = f"window.__hogDappEmit && window.__hogDappEmit({json.dumps(event)}, {json.dumps(payload)})"
        for view in self.views.values():
            if page_origin(view.get_uri() or "") == origin:
                self.run_on_view(view, script)

    def dapp_object(self, raw):
        if not isinstance(raw, str) or len(raw) > 200_000:
            return None
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            return None
        return data if isinstance(data, dict) else None

    def dapp_resolve_script(self, req_id, ok, payload):
        flag = "true" if ok else "false"
        return f"window.__hogDappResolve && window.__hogDappResolve({int(req_id)}, {flag}, {json.dumps(payload)})"

    def run_on_view(self, view, script):
        try:
            view.run_javascript(script, None, None, None)
        except Exception:
            pass

    def shared(self):
        if self.shared_context is not None:
            return self.shared_context
        data = DATA / "pages"
        cache = DATA / "pages-cache"
        data.mkdir(parents=True, exist_ok=True)
        cache.mkdir(parents=True, exist_ok=True)
        manager = WebKit2.WebsiteDataManager(
            base_data_directory=str(data),
            base_cache_directory=str(cache),
        )
        context = WebKit2.WebContext.new_with_website_data_manager(manager)
        harden_page_context(context, manager)
        self.shared_context = context
        return context

    def tune(self, view):
        settings = view.get_settings()
        settings.set_enable_javascript(True)
        settings.set_enable_smooth_scrolling(True)
        settings.set_enable_webgl(True)
        settings.set_enable_media(True)
        settings.set_javascript_can_access_clipboard(False)
        try:
            settings.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.ALWAYS)
        except Exception:
            pass
        background = Gdk.RGBA()
        background.parse("#ffffff")
        view.set_background_color(background)
        manager = view.get_user_content_manager()
        try:
            manager.register_script_message_handler("hogedge")
            manager.connect("script-message-received::hogedge", self.on_grip_message)
        except Exception:
            pass
        manager.add_script(WebKit2.UserScript.new(
            SVG_DROP_SHADOW_FIX,
            WebKit2.UserContentInjectedFrames.ALL_FRAMES,
            WebKit2.UserScriptInjectionTime.START,
            None,
            None,
        ))
        manager.add_script(WebKit2.UserScript.new(
            EDGE_GRIP_SCRIPT,
            WebKit2.UserContentInjectedFrames.TOP_FRAME,
            WebKit2.UserScriptInjectionTime.START,
            None,
            None,
        ))
        manager.add_script(WebKit2.UserScript.new(
            DAPP_PROVIDER_SCRIPT,
            WebKit2.UserContentInjectedFrames.TOP_FRAME,
            WebKit2.UserScriptInjectionTime.START,
            None,
            DAPP_PROVIDER_BLOCK_LIST,
        ))

    def allowed(self, uri):
        parts = split_uri(uri)
        if parts is None or parts.scheme not in ("http", "https"):
            return False
        if parts.username or parts.password:
            return False
        host = (parts.hostname or "").strip("[]").lower()
        if host in ("metadata.google.internal", "169.254.169.254"):
            return False
        if host in ("127.0.0.1", "localhost") and parts.port in (PORT, NODE_PORT):
            return False
        return True

    def emit_state(self, tab_id, event, **extra):
        view = self.views.get(str(tab_id))
        payload = {
            "id": str(tab_id),
            "event": event,
            "url": view.get_uri() if view is not None else "",
            "title": (view.get_title() or "") if view is not None else "",
            "back": bool(view and view.can_go_back()),
            "forward": bool(view and view.can_go_forward()),
            "loading": bool(view.is_loading()) if view is not None else False,
        }
        payload.update(extra)
        self.tell(payload)

    def ensure(self, tab_id, isolated):
        tab_id = str(tab_id)
        existing = self.views.get(tab_id)
        if existing is not None:
            return existing
        if isolated:
            manager = WebKit2.WebsiteDataManager.new_ephemeral()
            context = WebKit2.WebContext.new_with_website_data_manager(manager)
            harden_page_context(context, manager)
        else:
            context = self.shared()
        view = WebKit2.WebView.new_with_context(context)
        self.tune(view)
        view.connect("decide-policy", self.on_decide, tab_id)
        view.connect("load-changed", self.on_load, tab_id)
        view.connect("load-failed", self.on_fail, tab_id)
        try:
            view.connect("load-failed-with-tls-errors", self.on_tls, tab_id)
        except Exception:
            pass
        view.connect("notify::title", self.on_title, tab_id)
        self.box.add_named(view, tab_id)
        view.show()
        if self.on_view is not None:
            self.on_view(view)
        self.views[tab_id] = view
        self.isolated[tab_id] = bool(isolated)
        return view

    def on_decide(self, view, decision, decision_type, tab_id):
        if decision_type == WebKit2.PolicyDecisionType.RESPONSE:
            decision.use()
            return True
        try:
            action = decision.get_navigation_action()
            uri = action.get_request().get_uri() or ""
        except Exception:
            decision.use()
            return True
        if decision_type == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
            # A click may open a new tab. A page may not open one by itself.
            if uri and self.allowed(uri) and action.is_user_gesture():
                self.tell({
                    "event": "popup",
                    "url": uri,
                    "isolated": bool(self.isolated.get(str(tab_id), False)),
                })
            decision.ignore()
            return True
        if self.allowed(uri) or in_page_navigation(uri):
            decision.use()
            return True
        # Sites probe mailto:, intent:, and other schemes on their own.
        # Drop those quietly. A page-sized error hides the site the person is reading.
        decision.ignore()
        return True

    def on_load(self, view, event, tab_id):
        if event == WebKit2.LoadEvent.STARTED:
            self.emit_state(tab_id, "start", loading=True)
        elif event == WebKit2.LoadEvent.COMMITTED:
            self.emit_state(tab_id, "commit", loading=True)
            if str(tab_id) == self.shown:
                self.repaint_grips()
                self.repaint_menu()
        elif event == WebKit2.LoadEvent.FINISHED:
            self.emit_state(tab_id, "finish", loading=False)
            if str(tab_id) == self.shown:
                self.repaint_grips()
                self.repaint_menu()

    def on_fail(self, view, _event, uri, error, tab_id):
        if quiet_load_error(view, uri, error):
            self.emit_state(tab_id, "stop", loading=False)
            return False
        message = getattr(error, "message", "") or "Could not open that page"
        self.emit_state(tab_id, "fail", url=uri or "", error=message, loading=False)
        return False

    def on_tls(self, _view, uri, _certificate, _errors, tab_id):
        self.emit_state(
            tab_id,
            "fail",
            url=uri or "",
            error="The site certificate was not accepted",
            loading=False,
        )
        return False

    def on_title(self, view, _pspec, tab_id):
        if view.get_title():
            self.emit_state(tab_id, "title")

    def load(self, tab_id, isolated, url):
        if not self.allowed(url):
            self.tell({
                "id": str(tab_id),
                "event": "fail",
                "url": url,
                "error": "Only http and https pages can be opened",
                "loading": False,
            })
            return
        view = self.ensure(tab_id, isolated)
        view.load_uri(url)

    def place(self, left, top, right, bottom, show, tab_id):
        left, top, right, bottom = (max(0, int(left)), max(0, int(top)), max(0, int(right)), max(0, int(bottom)))
        box = self.box
        if (
            box.get_margin_start() != left
            or box.get_margin_top() != top
            or box.get_margin_end() != right
            or box.get_margin_bottom() != bottom
        ):
            box.set_margin_start(left)
            box.set_margin_top(top)
            box.set_margin_end(right)
            box.set_margin_bottom(bottom)
        tab_id = str(tab_id or "")
        if not show or tab_id not in self.views:
            self.box.hide()
            self.shown = None
            return
        self.box.set_visible_child_name(tab_id)
        self.box.show()
        if self.shown != tab_id:
            self.views[tab_id].grab_focus()
            self.shown = tab_id
        self.repaint_grips()
        self.repaint_menu()

    def drop(self, tab_id):
        tab_id = str(tab_id)
        view = self.views.pop(tab_id, None)
        self.isolated.pop(tab_id, None)
        if view is None:
            return
        self.box.remove(view)
        if self.shown == tab_id:
            self.shown = None
            self.box.hide()
        view.destroy()

    def command(self, command):
        if command.startswith("view:"):
            parts = command.split(":")
            if len(parts) < 6:
                return True
            try:
                left, top, right, bottom, show = (
                    int(parts[1]), int(parts[2]), int(parts[3]), int(parts[4]), int(parts[5]),
                )
            except ValueError:
                return True
            tab_id = parts[6] if len(parts) > 6 else ""
            self.place(left, top, right, bottom, show == 1, tab_id)
            return True
        if command.startswith("page:"):
            try:
                _, tab_id, iso, url = command.split(":", 3)
            except ValueError:
                return True
            self.load(tab_id, iso == "1", url)
            return True
        if command.startswith("drop:"):
            self.drop(command.split(":", 1)[1])
            return True
        if command.startswith("back:"):
            view = self.views.get(command.split(":", 1)[1])
            if view is not None and view.can_go_back():
                view.go_back()
            return True
        if command.startswith("fwd:"):
            view = self.views.get(command.split(":", 1)[1])
            if view is not None and view.can_go_forward():
                view.go_forward()
            return True
        if command.startswith("reload:"):
            view = self.views.get(command.split(":", 1)[1])
            if view is not None:
                view.reload()
            return True
        if command.startswith("stop:"):
            view = self.views.get(command.split(":", 1)[1])
            if view is not None:
                view.stop_loading()
            return True
        if command.startswith("zoom:"):
            bits = command.split(":")
            if len(bits) != 3:
                return True
            view = self.views.get(bits[1])
            try:
                level = float(bits[2])
            except ValueError:
                return True
            if view is not None:
                view.set_zoom_level(level)
            return True
        return False


class EdgePill:
    """Floating Wallet or Tabs label drawn above a native page.

    The page view covers the chrome, so a hover label that hangs over the
    page has to be a real GTK widget. It is only the pill, never a column.
    """

    def __init__(self, chrome):
        self.chrome = chrome
        self.side = "tabs"
        self.flat = "left"
        self.label = ""
        self.area = Gtk.DrawingArea()
        self.area.set_halign(Gtk.Align.START)
        self.area.set_valign(Gtk.Align.START)
        self.area.set_hexpand(False)
        self.area.set_vexpand(False)
        self.area.set_no_show_all(True)
        self.area.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.ENTER_NOTIFY_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
        )
        self.area.connect("draw", self.on_draw)
        self.area.connect("button-press-event", self.on_press)
        self.area.connect("enter-notify-event", self.on_enter)
        self.area.connect("leave-notify-event", self.on_leave)
        self.area.connect("realize", self.on_realize)

    def widget(self):
        return self.area

    def on_realize(self, widget):
        window = widget.get_window()
        if window is not None:
            window.set_cursor(Gdk.Cursor.new_for_display(widget.get_display(), Gdk.CursorType.HAND2))

    def show_at(self, x, y, w, h, side, label):
        if w < 48 or w > 180 or h < 24 or h > 48:
            return
        if side not in ("tabs", "wallet") or not label or len(label) > 32:
            return
        self.side = side
        self.flat = "left" if side == "tabs" else "right"
        self.label = label
        x = max(0, int(x))
        y = max(0, int(y))
        self.area.set_size_request(w, h)
        self.area.set_margin_start(x)
        self.area.set_margin_top(y)
        parent = self.area.get_parent()
        if parent is not None:
            parent_w = parent.get_allocated_width()
            parent_h = parent.get_allocated_height()
            if parent_w > 0:
                self.area.set_margin_end(max(0, parent_w - x - w))
            if parent_h > 0:
                self.area.set_margin_bottom(max(0, parent_h - y - h))
        self.area.queue_draw()
        self.area.show()

    def hide(self, tell=False):
        visible = self.area.get_visible()
        self.area.hide()
        if tell and visible:
            self._js("window.__hogPillHide && window.__hogPillHide()")

    def _js(self, script):
        try:
            self.chrome.run_javascript(script, None, None, None)
        except Exception:
            pass

    def on_enter(self, _widget, _event):
        self._js("window.__hogPillHold && window.__hogPillHold()")
        return False

    def on_leave(self, _widget, _event):
        self.hide(tell=True)
        return False

    def on_press(self, _widget, event):
        if getattr(event, "button", 1) != 1:
            return False
        side = self.side
        self.hide(tell=False)
        element = "tabs-edge" if side == "tabs" else "wallet-edge"
        self._js(f"document.getElementById('{element}').click()")
        return True

    def _path(self, cr, x, y, w, h):
        radius = h / 2.0
        cr.new_path()
        if self.flat == "left":
            cr.move_to(x, y)
            cr.line_to(x + w - radius, y)
            cr.arc(x + w - radius, y + radius, radius, -math.pi / 2, math.pi / 2)
            cr.line_to(x, y + h)
        else:
            cr.move_to(x + w, y)
            cr.line_to(x + radius, y)
            cr.arc_negative(x + radius, y + radius, radius, -math.pi / 2, math.pi / 2)
            cr.line_to(x + w, y + h)
        cr.close_path()

    def on_draw(self, widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        if width < 2 or height < 2:
            return False
        self._path(cr, 0, 0, width, height)
        cr.set_source_rgb(0x24 / 255, 0x26 / 255, 0x24 / 255)
        cr.fill()
        layout = widget.create_pango_layout(self.label)
        desc = Pango.FontDescription()
        desc.set_size(13 * Pango.SCALE)
        desc.set_weight(Pango.Weight.SEMIBOLD)
        layout.set_font_description(desc)
        text_w, text_h = layout.get_pixel_size()
        cr.set_source_rgb(0.957, 0.957, 0.965)
        cr.move_to(max(8, (width - text_w) / 2), max(0, (height - text_h) / 2))
        PangoCairo.show_layout(cr, layout)
        return False


GOLD = (0xfd / 255, 0xb9 / 255, 0x13 / 255)
DOT = (0x2a / 255, 0x1d / 255, 0x05 / 255)


def place_overlay(area, x, y, w, h):
    x = max(0, int(x))
    y = max(0, int(y))
    w = max(1, int(w))
    h = max(1, int(h))
    area.set_size_request(w, h)
    area.set_margin_start(x)
    area.set_margin_top(y)
    parent = area.get_parent()
    if parent is not None:
        parent_w = parent.get_allocated_width()
        parent_h = parent.get_allocated_height()
        if parent_w > 0:
            area.set_margin_end(max(0, parent_w - x - w))
        if parent_h > 0:
            area.set_margin_bottom(max(0, parent_h - y - h))
    area.queue_draw()
    area.show()


class ShareDrop:
    """Invisible drop target over the Jellyfin card. Files land in ~/hog-shares."""

    def __init__(self, on_uris):
        self.on_uris = on_uris
        self.hot = False
        self.area = Gtk.DrawingArea()
        self.area.set_halign(Gtk.Align.START)
        self.area.set_valign(Gtk.Align.START)
        self.area.set_hexpand(False)
        self.area.set_vexpand(False)
        self.area.set_app_paintable(True)
        self.area.set_no_show_all(True)
        self.area.connect("draw", self.on_draw)
        self.area.connect("realize", self.on_realize)
        self.area.drag_dest_set(Gtk.DestDefaults.DROP, [], Gdk.DragAction.COPY)
        self.area.drag_dest_add_uri_targets()
        self.area.connect("drag-motion", self.on_motion)
        self.area.connect("drag-leave", self.on_leave)
        self.area.connect("drag-data-received", self.on_received)

    def widget(self):
        return self.area

    def on_realize(self, widget):
        screen = widget.get_screen()
        visual = screen.get_rgba_visual() if screen is not None else None
        if visual is not None:
            widget.set_visual(visual)

    def show_box(self, x, y, w, h):
        if w < 40 or h < 36:
            self.area.hide()
            return
        place_overlay(self.area, x, y, w, h)

    def hide(self):
        self.hot = False
        self.area.hide()

    def on_draw(self, _widget, cr):
        if self.hot:
            cr.set_source_rgba(GOLD[0], GOLD[1], GOLD[2], 0.28)
            cr.paint()
        return False

    def on_motion(self, widget, context, _x, _y, when):
        self.hot = True
        widget.queue_draw()
        Gdk.drag_status(context, Gdk.DragAction.COPY, when)
        return True

    def on_leave(self, widget, _context, _when):
        self.hot = False
        widget.queue_draw()

    def on_received(self, widget, context, _x, _y, data, _info, when):
        uris = [uri for uri in (data.get_uris() or []) if uri.startswith("file://")]
        self.hot = False
        widget.queue_draw()
        Gtk.drag_finish(context, bool(uris), False, when)
        if uris:
            self.on_uris(uris)


class EdgeLine:
