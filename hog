# and the view is short. Page scripts drop only that function.
SVG_DROP_SHADOW_FIX = r"""
(function () {
  var pattern = /drop-shadow\((?:[^()]|\([^()]*\))*\)/g;
  function scrub(root) {
    if (!root || root.nodeType !== 1) return;
    var list = root.localName === "svg" ? [root] : (root.querySelectorAll ? root.querySelectorAll("svg") : []);
    for (var i = 0; i < list.length; i++) {
      var svg = list[i];
      var filter;
      try { filter = getComputedStyle(svg).filter; } catch (e) { continue; }
      if (!filter || filter === "none" || filter.indexOf("drop-shadow") === -1) continue;
      var next = filter.replace(pattern, " ").replace(/\s+/g, " ").trim();
      svg.style.setProperty("filter", next || "none", "important");
    }
  }
  var armed = false;
  function arm() {
    var root = document.documentElement;
    if (!root) return;
    scrub(root);
    if (armed) return;
    armed = true;
    var observer = new MutationObserver(function (records) {
      for (var i = 0; i < records.length; i++) {
        var nodes = records[i].addedNodes;
        for (var j = 0; j < nodes.length; j++) scrub(nodes[j]);
      }
